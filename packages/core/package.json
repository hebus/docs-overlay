{
  "name": "docs-overlay",
  "version": "0.2.0",
  "description": "Version your documentation without duplicating it: author only the diff between versions and let the engine resolve inheritance. Framework-agnostic, zero dependencies.",
  "license": "MIT",
  "author": "Olivier Tomé",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "keywords": [
    "documentation-versioning",
    "versioned-documentation",
    "documentation",
    "docs",
    "versioning",
    "docs-as-code",
    "monorepo",
    "markdown",
    "overlay",
    "inheritance",
    "framework-agnostic",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/docs-overlay.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hebus/docs-overlay/tree/main/packages/core#readme",
  "bugs": "https://github.com/hebus/docs-overlay/issues"
}
