{
  "name": "docs-overlay-docusaurus",
  "version": "0.2.2",
  "description": "Versioned documentation for Docusaurus without copying versioned_docs: author only the diff between versions, and let the build materialise the snapshots Docusaurus reads.",
  "license": "MIT",
  "author": "Olivier Tomé",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "docs-overlay": "^0.2.1"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-versioning",
    "versioned-docs",
    "documentation-versioning",
    "versioned-documentation",
    "documentation",
    "docs",
    "versioning",
    "markdown",
    "mdx",
    "docs-as-code",
    "docs-overlay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/docs-overlay.git",
    "directory": "packages/adapters/docusaurus"
  },
  "homepage": "https://github.com/hebus/docs-overlay/tree/main/packages/adapters/docusaurus#readme",
  "bugs": "https://github.com/hebus/docs-overlay/issues"
}
