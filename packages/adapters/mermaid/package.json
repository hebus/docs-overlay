{
  "name": "docs-overlay-mermaid",
  "version": "0.2.0",
  "description": "Mermaid to modern technical SVG: a semantic diagram model and a DOM-free renderer, so diagrams ship as HTML instead of a browser bundle.",
  "license": "MIT",
  "author": "Olivier Tomé",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@mermaid-js/parser": "^1.2.1"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "architecture-beta",
    "svg",
    "ssr",
    "documentation",
    "docs",
    "docs-as-code",
    "accessibility",
    "dark-mode",
    "docs-overlay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/docs-overlay.git",
    "directory": "packages/adapters/mermaid"
  },
  "homepage": "https://github.com/hebus/docs-overlay/tree/main/packages/adapters/mermaid#readme",
  "bugs": "https://github.com/hebus/docs-overlay/issues"
}
