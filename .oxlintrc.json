{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-floating-promises": "warn",
    "typescript/no-unsafe-assignment": "warn"
  },
  "env": {
    "builtin": true,
    "es2022": true
  },
  "ignorePatterns": ["**/dist/**", "**/out/**", "**/.next/**", "**/.source/**", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "next",
                  "next/*",
                  "fumadocs-core",
                  "fumadocs-core/*",
                  "fumadocs-ui",
                  "fumadocs-ui/*",
                  "fumadocs-mdx",
                  "fumadocs-mdx/*",
                  "astro",
                  "astro/*",
                  "nextra",
                  "nextra/*",
                  "vitepress",
                  "vitepress/*",
                  "node:*",
                  "node:*/*",
                  "fs",
                  "fs/*",
                  "path",
                  "url",
                  "os",
                  "crypto"
                ],
                "message": "docs-overlay must stay framework-agnostic and free of Node built-ins. Put this in an adapter."
              }
            ]
          }
        ]
      }
    }
  ]
}
