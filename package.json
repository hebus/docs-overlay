{
  "name": "docs-overlay",
  "private": true,
  "type": "module",
  "description": "Version your documentation without duplicating it — framework-agnostic engine, Fumadocs and Docusaurus adapters, and one command line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/docs-overlay.git"
  },
  "homepage": "https://hebus.github.io/docs-overlay",
  "bugs": "https://github.com/hebus/docs-overlay/issues",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/adapters/*",
    "packages/cli",
    "apps/*",
    "examples/*",
    "!examples/docusaurus-classic"
  ],
  "scripts": {
    "build": "npm run build -w docs-overlay -w docs-overlay-fumadocs -w docs-overlay-docusaurus -w docs-overlay-cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/test && tsc -p packages/adapters/fumadocs && tsc -p packages/adapters/docusaurus && tsc -p packages/adapters/docusaurus/test && tsc -p packages/cli",
    "typecheck:packaged": "tsc -p packages/adapters/fumadocs/tsconfig.packaged.json && tsc -p packages/adapters/docusaurus/tsconfig.packaged.json && tsc -p packages/cli/tsconfig.packaged.json",
    "verify:independence": "node scripts/verify-independence.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && npm install --package-lock-only && node scripts/cut-docs.mjs",
    "release": "tsx scripts/release.ts",
    "prepare": "husky",
    "build:example": "npm run build -w docs-overlay-example",
    "build:example:multi": "npm run build -w docs-overlay-example-multi",
    "build:docs": "npm run build -w docs-overlay-site",
    "release:dry": "tsx scripts/release.ts --dry-run",
    "check:journal": "node scripts/check-journal.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "render:journal": "node scripts/render-journal.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@clack/prompts": "^1.1.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "oxlint",
    "*.{js,mjs,ts,tsx,json,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
