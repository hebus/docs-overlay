{
  "name": "docs-overlay",
  "private": true,
  "type": "module",
  "description": "Versioned documentation with overlay inheritance \u2014 framework-agnostic core plus framework adapters.",
  "license": "MIT",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @docs-overlay/core -w @docs-overlay/fumadocs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/test && tsc -p packages/adapters/fumadocs",
    "typecheck:packaged": "tsc -p packages/adapters/fumadocs/tsconfig.packaged.json",
    "verify:independence": "node scripts/verify-independence.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "build:example": "npm run build -w @docs-overlay/example-fumadocs-next"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "oxlint",
    "*.{js,mjs,ts,tsx,json,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
